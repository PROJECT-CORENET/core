# ── Обязательно ──
# Публичный адрес ноды: IP или домен сервера + порт. Попадает в адрес core://…,
# по нему к ноде подключаются клиенты и другие ноды.
CORE_PUBLIC_HOST=203.0.113.10:7443

# ── Подключение к сети ──
# Адреса других нод через запятую (их выдаёт `core-node info` на той ноде).
# Пусто — нода стоит одна, пока к ней не подключится кто-то другой.
CORE_BOOTSTRAP=

# ── Для карты сети (необязательно) ──
CORE_NAME=
CORE_REGION=

# ── Прочее ──
# Порт на хосте
CORE_PORT=7443
# Готовый образ из GitHub Container Registry вместо локальной сборки:
# CORE_IMAGE=ghcr.io/<owner>/core-node:latest
RUST_LOG=info
